# Zoho CRM Configuration
# Get these credentials from your Zoho CRM account
# All values are required for the API integration to work

# Zoho OAuth Client ID
# Available at: https://accounts.zoho.in/developerconsole
# Format: 1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_CLIENT_ID=your_client_id_here

# Zoho OAuth Client Secret
# Available at: https://accounts.zoho.in/developerconsole
# Keep this secret and never commit it to version control
ZOHO_CLIENT_SECRET=your_client_secret_here

# Zoho Refresh Token
# Generate by completing the OAuth flow in Zoho Developer Console
# Format: 1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# This token is used to obtain access tokens automatically
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho API Domain (India data center)
# For other data centers, use:
#   - https://www.zohoapis.com (US)
#   - https://www.zohoapis.eu (EU)
#   - https://www.zohoapis.com.au (Australia)
#   - https://www.zohoapis.in (India - default)
ZOHO_API_DOMAIN=https://www.zohoapis.in

# IMPORTANT SECURITY NOTES:
# ═════════════════════════════════════════════════════════════
# 1. NEVER commit actual credentials to git (use .gitignore)
# 2. Use this .env.example file only as a template
# 3. Create a .env file locally with your actual credentials
# 4. Add your credentials to Vercel environment variables for production
# 5. The .env file is already in .gitignore for protection
# 6. All Zoho credentials are used only server-side in api/enquiry.js
# 7. No credentials are ever sent to the frontend (browser)
